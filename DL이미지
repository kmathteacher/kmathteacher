<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>제1사분면 그리기 프로그램</title>
    <style>
        body {
            font-family: sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0;
            background-color: #f0f0f0;
            padding: 20px;
        }
        h1 {
            color: #333;
        }
        #controls {
            margin: 20px 0;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            background-color: #555;
            color: white;
            transition: background-color 0.3s;
        }
        button.active {
            background-color: #d9534f;
        }
        button:hover:not(.active) {
            background-color: #777;
        }
        canvas {
            border: 1px solid #ccc;
            background-color: #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        #info {
            margin-top: 15px;
            color: #666;
        }
    </style>
</head>
<body>

    <h1>제1사분면 그리기</h1>
    <div id="controls">
        <button id="pointBtn" class="active">점 찍기 (X)</button>
        <button id="curveBtn">곡선 그리기</button>
        <button id="lineBtn">직선 그리기</button>
        <button id="normalDistBtn">정규분포 곡선</button>
    </div>
    <canvas id="coordCanvas" width="600" height="600"></canvas>
    <div id="info">💡 Ctrl+Z를 눌러 실행 취소할 수 있습니다.</div>

    <script>
        const canvas = document.getElementById('coordCanvas');
        const ctx = canvas.getContext('2d');
        const { width, height } = canvas;

        let currentMode = 'point';
        let isDrawing = false;
        
        let points = [], curves = [], lines = [], normalDistributions = [];
        let tempLineStart = null;
        let history = [];

        // 정규분포 곡선 설정값
        const NORMAL_STD_DEV = 50; // 표준편차 (클수록 넓어짐)
        const NORMAL_AMPLITUDE = 120; // 진폭 (클수록 높아짐)
        const colorPalette = ['#E6194B', '#3CB44B', '#4363D8', '#F58231', '#911EB4', '#46F0F0', '#F032E6', '#BCF60C', '#FABEBE', '#008080', '#E6BEFF', '#9A6324'];

        const pointBtn = document.getElementById('pointBtn');
        const curveBtn = document.getElementById('curveBtn');
        const lineBtn = document.getElementById('lineBtn');
        const normalDistBtn = document.getElementById('normalDistBtn');

        function saveState() {
            history.push({
                points: JSON.parse(JSON.stringify(points)),
                curves: JSON.parse(JSON.stringify(curves)),
                lines: JSON.parse(JSON.stringify(lines)),
                normalDistributions: JSON.parse(JSON.stringify(normalDistributions)),
            });
        }

        function undo() {
            if (history.length > 0) {
                const lastState = history.pop();
                points = lastState.points;
                curves = lastState.curves;
                lines = lastState.lines;
                normalDistributions = lastState.normalDistributions || [];
                redraw();
            } else {
                alert("더 이상 취소할 내용이 없습니다.");
            }
        }

        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && (e.key === 'z' || e.key === 'Z')) {
                e.preventDefault();
                undo();
            }
        });

        function setActiveButton(mode) {
            [pointBtn, curveBtn, lineBtn, normalDistBtn].forEach(btn => btn.classList.remove('active'));
            if (mode === 'point') pointBtn.classList.add('active');
            else if (mode === 'curve') curveBtn.classList.add('active');
            else if (mode === 'line') lineBtn.classList.add('active');
            else if (mode === 'normal') normalDistBtn.classList.add('active');
        }

        pointBtn.onclick = () => { currentMode = 'point'; setActiveButton('point'); };
        curveBtn.onclick = () => { currentMode = 'curve'; setActiveButton('curve'); };
        lineBtn.onclick = () => { currentMode = 'line'; setActiveButton('line'); tempLineStart = null; };
        normalDistBtn.onclick = () => { currentMode = 'normal'; setActiveButton('normal'); };

        function drawAxes() {
            ctx.beginPath();
            ctx.strokeStyle = '#000';
            ctx.lineWidth = 2;
            ctx.moveTo(2, height); ctx.lineTo(2, 0);
            ctx.moveTo(0, height - 2); ctx.lineTo(width, height - 2);
            ctx.stroke();
        }

        function drawNormalDistribution(mean_x, mean_y, color) {
            ctx.beginPath();
            ctx.strokeStyle = color;
            ctx.lineWidth = 2.5;

            const startX = mean_x - 3 * NORMAL_STD_DEV;
            const endX = mean_x + 3 * NORMAL_STD_DEV;

            for (let x = startX; x <= endX; x++) {
                const exponent = -Math.pow(x - mean_x, 2) / (2 * Math.pow(NORMAL_STD_DEV, 2));
                const y = mean_y - NORMAL_AMPLITUDE * Math.exp(exponent);
                if (x === startX) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }

        function redraw() {
            ctx.clearRect(0, 0, width, height);
            drawAxes();

            // 점, 곡선, 선 그리기 (기존 코드)
            ctx.fillStyle = '#0056b3';
            ctx.font = '20px Arial';
            points.forEach(p => ctx.fillText('X', p.x - 7, p.y + 7));

            ctx.strokeStyle = '#28a745';
            ctx.lineWidth = 2;
            curves.forEach(curve => { /* ... */ });
            curves.forEach(curve => {
                if (curve.length < 2) return;
                ctx.beginPath();
                ctx.moveTo(curve[0].x, curve[0].y);
                for (let i = 1; i < curve.length - 1; i++) {
                    const xc = (curve[i].x + curve[i + 1].x) / 2;
                    const yc = (curve[i].y + curve[i + 1].y) / 2;
                    ctx.quadraticCurveTo(curve[i].x, curve[i].y, xc, yc);
                }
                ctx.stroke();
            });


            ctx.strokeStyle = '#dc3545';
            ctx.lineWidth = 2;
            lines.forEach(line => { /* ... */ });
            lines.forEach(line => {
                ctx.beginPath();
                ctx.moveTo(line.start.x, line.start.y);
                ctx.lineTo(line.end.x, line.end.y);
                ctx.stroke();
            });

            // 정규분포 곡선 그리기
            normalDistributions.forEach(dist => {
                drawNormalDistribution(dist.mean_x, dist.mean_y, dist.color);
            });
        }

        canvas.addEventListener('click', (e) => {
            if (currentMode === 'point') {
                saveState();
                const pos = { x: e.offsetX, y: e.offsetY };
                points.push(pos);
                redraw();
            } else if (currentMode === 'normal') {
                saveState();
                const pos = { x: e.offsetX, y: e.offsetY };
                const color = colorPalette[normalDistributions.length % colorPalette.length];
                normalDistributions.push({ mean_x: pos.x, mean_y: pos.y, color: color });
                redraw();
            }
        });
        
        canvas.addEventListener('mousedown', (e) => {
            const pos = { x: e.offsetX, y: e.offsetY };
            if (currentMode === 'curve') {
                saveState();
                isDrawing = true;
                curves.push([pos]);
            } else if (currentMode === 'line') {
                if (!tempLineStart) {
                    tempLineStart = pos;
                } else {
                    saveState();
                    lines.push({ start: tempLineStart, end: pos });
                    tempLineStart = null;
                    redraw();
                }
            }
        });
        
        canvas.addEventListener('mousemove', (e) => {
            if (isDrawing && currentMode === 'curve') {
                const pos = { x: e.offsetX, y: e.offsetY };
                curves[curves.length - 1].push(pos);
                redraw(); 
            }
        });

        canvas.addEventListener('mouseup', () => {
            if (isDrawing) isDrawing = false;
        });

        redraw();
        saveState();
    </script>

</body>
</html>
